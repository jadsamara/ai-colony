# Copy to a file that is not committed. Do not put this file in git.
# DATABASE_URL and RABBITMQ_URL come from the operator environment or Secret Manager.
# COLONY_DEDICATED_ROUTING stays off until `pnpm colony:routing:activate` probes every instance.
#
# ./scripts/colony profiles:
#   COLONY_PROFILE=local  (default) — root docker-compose.yml + host API + host Ollama
#   COLONY_PROFILE=gpu    — existing deploy Compose stack + colony-api-test
COLONY_PROFILE=gpu
COLONY_ACCEPT_TASKS=false
COLONY_DEDICATED_ROUTING=off
COLONY_MODE=real
INFERENCE_MODEL_ALIAS=qwen3:8b
# Container-side DB URL for agents/API on network colony-db (hostname postgres).
# Use the same database the live API already uses (on this VM: ai_colony_v2).
# DATABASE_URL=postgres://colony:colony@postgres:5432/ai_colony_v2
# RABBITMQ_URL=amqp://colony:colony-dev-password@rabbitmq-host:5672
# Optional GPU ops toggles for ./scripts/colony:
# COLONY_GPU_MANAGE_POSTGRES=true
# COLONY_GPU_STOP_POSTGRES=false
# COLONY_GPU_PUBLISHER=true
# COLONY_GPU_API_PROJECT=ai-colony-api
# COLONY_GPU_INFERENCE_BASE_URL=http://ollama-science:11434
# Set these from measured machine capacity before `pnpm colony:start`.
# COLONY_GPU_VRAM_BYTES=
# COLONY_HOST_RAM_BYTES=
# COLONY_MODEL_DISK_BYTES=
# COLONY_QWEN3_8B_DIGEST=
# COLONY_ALLOW_MODEL_DOWNLOAD=false
