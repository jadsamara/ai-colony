{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ai-colony/contracts": ["./packages/contracts/src/index.ts"],
      "@ai-colony/core": ["./packages/core/src/index.ts"],
      "@ai-colony/database": ["./packages/database/src/index.ts"],
      "@ai-colony/messaging": ["./packages/messaging/src/index.ts"],
      "@ai-colony/inference": ["./packages/inference/src/index.ts"],
      "@ai-colony/workflows": ["./packages/workflows/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "research/**/*.ts",
    "scripts/run-m75-phase1.ts",
    "scripts/run-m75b.ts",
    "scripts/record-m75b-history.ts",
    "scripts/run-c18a-math-baseline.ts",
    "drizzle.config.ts",
    "vitest.unit.config.ts",
    "vitest.integration.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
