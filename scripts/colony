#!/usr/bin/env bash
# C1.7.5 — One-command Colony deployment and testing entrypoint.
# Profiles: COLONY_PROFILE=local (default) | gpu
# Never runs `docker compose down -v`. Never auto-downloads multi-GB models.
# Never truncates/reseeds an existing DB. deploy does NOT git pull.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/colony-common.sh
source "${SCRIPT_DIR}/lib/colony-common.sh"

usage() {
  cat <<'EOF'
Usage: ./scripts/colony [--profile local|gpu] <command> [args]

Profiles (COLONY_PROFILE):
  local   Root docker-compose.yml + host API + host Ollama (default)
  gpu     Existing deploy GPU stack (gcp+gpu+database[+publisher]),
          deploy postgres volume, and colony-api-test on colony-db + colony-dedicated

Commands:
  up        Start services for the profile, migrate once, ensure API, check Ollama
  down      Stop profile services safely; never deletes volumes (-v refused)
  deploy    Rebuild from checked-out code (no git pull), migrate, start
  restart   Restart profile services and re-check readiness
  status    Show DB, API, Ollama/model, migration, and profile status
  logs      Show/follow logs (local compose services, gpu dedicated/api, or `api`)
  test      C1.7.4 spacecraft conversation via authenticated API
  help      Show this help

Notes:
  - `up` does not rebuild unless required images are missing (gpu migrate/API).
  - `deploy` uses the current checkout only; operators git pull/checkout themselves.
  - Seed once manually with `pnpm db:seed` (or containerized equivalent) if departments are absent.
  - Dedicated CLI remains available: `pnpm colony:start` / `pnpm colony:stop`.
EOF
}

colony_parse_global_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ $# -ge 2 ]] || colony_die "${EXIT_USAGE}" "--profile requires local|gpu"
        export COLONY_PROFILE="$2"
        shift 2
        ;;
      --profile=*)
        export COLONY_PROFILE="${1#*=}"
        shift
        ;;
      *)
        break
        ;;
    esac
  done
  COLONY_ARGS=("$@")
}

cmd_up_local() {
  colony_log "profile=local Starting Compose services (no rebuild)..."
  colony_compose_local up -d --no-build
  colony_wait_postgres_local
  colony_wait_rabbit_local
  colony_migrate_local
  colony_start_api_local
  if colony_check_ollama_local; then
    colony_log "Ollama/model check passed."
  else
    colony_warn "Ollama/model not ready. Infra and API are up; inference tests will fail until the model is installed locally."
  fi
  if ! colony_seed_present_local; then
    colony_warn "Founding Science department missing. Run once: pnpm db:seed"
  fi
}

cmd_up_gpu() {
  colony_log "profile=gpu Reusing existing dedicated Compose project ai-colony-dedicated (no volume wipe, no model download)."
  colony_gpu_ensure_postgres
  colony_wait_postgres_gpu
  colony_migrate_gpu
  colony_log "Starting dedicated GPU services (existing service names/volumes)..."
  # --no-build on up: deploy handles rebuilds. --wait for healthchecks with compose timeout.
  if ! colony_compose_gpu_dedicated up -d --no-build --wait --wait-timeout "${COLONY_DB_WAIT_SECONDS}"; then
    colony_die "${EXIT_READY}" "GPU dedicated stack failed readiness. Migrations already applied; API was not started."
  fi
  if colony_check_gpu_ollama; then
    colony_log "Required department Ollama endpoints report model ${INFERENCE_MODEL_ALIAS}."
  else
    colony_warn "One or more required Ollama endpoints missing ${INFERENCE_MODEL_ALIAS}. No download attempted."
  fi
  colony_start_api_gpu
  if ! colony_seed_present_gpu; then
    colony_warn "Founding Science department missing on GPU DB. Seed manually once (never auto-run)."
  fi
}

cmd_up() {
  colony_reject_volume_wipe "$@"
  colony_load_env
  colony_ensure_state_dir
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    cmd_up_gpu
  else
    cmd_up_local
  fi
  colony_log "up complete (profile=${COLONY_PROFILE})."
}

cmd_down_local() {
  colony_stop_api_local || true
  colony_log "Stopping local Compose services without deleting volumes..."
  colony_compose_local stop -t 30 || true
  colony_compose_local down --remove-orphans
  colony_log "down complete. Volumes ai_colony_postgres / ai_colony_rabbitmq preserved."
}

cmd_down_gpu() {
  colony_stop_api_gpu || true
  colony_log "Stopping dedicated GPU services with stop -t 30 (never -v)..."
  colony_compose_gpu_dedicated stop -t 30 || true
  if [[ "${COLONY_GPU_STOP_POSTGRES}" == "true" ]]; then
    colony_log "COLONY_GPU_STOP_POSTGRES=true; stopping postgres (volume colony-postgres-data preserved)."
    colony_compose_gpu_postgres stop -t 30 || true
  else
    colony_log "Leaving GPU postgres running (set COLONY_GPU_STOP_POSTGRES=true to stop it)."
  fi
  colony_log "down complete. Named volumes colony-model-* / colony-postgres-data preserved."
}

cmd_down() {
  colony_reject_volume_wipe "$@"
  if [[ "$*" == *"-v"* || "$*" == *"--volumes"* ]]; then
    colony_die "${EXIT_USAGE}" "Refusing docker compose down -v / --volumes."
  fi
  colony_load_env || true
  colony_resolve_profile
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    cmd_down_gpu
  else
    cmd_down_local
  fi
}

cmd_deploy_local() {
  colony_log "Building TypeScript packages from checked-out code..."
  if ! (cd "${COLONY_ROOT}" && pnpm build); then
    colony_die "${EXIT_BUILD}" "Build failed. Migrations and API start aborted."
  fi
  colony_compose_local up -d --no-build
  colony_wait_postgres_local
  colony_wait_rabbit_local
  colony_migrate_local
  colony_stop_api_local || true
  colony_start_api_local
  colony_check_ollama_local || colony_warn "Ollama/model not ready after deploy."
}

cmd_deploy_gpu() {
  colony_log "Building agent/API image from checked-out code (no git pull)..."
  if ! (cd "${COLONY_ROOT}" && pnpm build); then
    colony_die "${EXIT_BUILD}" "TypeScript build failed before image rebuild."
  fi
  if ! docker build -f "${COLONY_ROOT}/deploy/Dockerfile.agent" -t "${COLONY_AGENT_IMAGE}" "${COLONY_ROOT}"; then
    colony_die "${EXIT_BUILD}" "Agent image build failed."
  fi
  colony_gpu_ensure_postgres
  colony_wait_postgres_gpu
  colony_migrate_gpu
  colony_compose_gpu_dedicated up -d --no-build --wait --wait-timeout "${COLONY_DB_WAIT_SECONDS}" \
    || colony_die "${EXIT_READY}" "GPU dedicated stack failed after migrate; API not started."
  colony_check_gpu_ollama || colony_warn "Ollama/model gaps after deploy (no download)."
  colony_stop_api_gpu || true
  # Recreate API container so it picks up rebuilt image layers when tagged same.
  colony_compose_gpu_api up -d --no-build --force-recreate colony-api-test \
    || colony_die "${EXIT_READY}" "colony-api-test recreate failed."
  local deadline=$((SECONDS + COLONY_API_WAIT_SECONDS))
  while (( SECONDS < deadline )); do
    if colony_api_ready; then
      colony_log "GPU API ready after deploy."
      return 0
    fi
    sleep 1
  done
  colony_die "${EXIT_READY}" "GPU API not ready after deploy."
}

cmd_deploy() {
  colony_reject_volume_wipe "$@"
  colony_load_env
  colony_ensure_state_dir
  colony_log "deploy uses CHECKED-OUT code only (no git pull). profile=${COLONY_PROFILE}"
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    cmd_deploy_gpu
  else
    cmd_deploy_local
  fi
  colony_log "deploy complete."
}

cmd_restart() {
  colony_reject_volume_wipe "$@"
  colony_load_env
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    colony_compose_gpu_dedicated restart || true
    colony_compose_gpu_api restart colony-api-test || true
    colony_wait_postgres_gpu
    local deadline=$((SECONDS + COLONY_API_WAIT_SECONDS))
    while (( SECONDS < deadline )); do
      colony_api_ready && break
      sleep 1
    done
    colony_check_gpu_ollama || colony_warn "Ollama/model not ready after restart."
  else
    colony_compose_local restart
    colony_wait_postgres_local
    colony_wait_rabbit_local
    colony_stop_api_local || true
    colony_start_api_local
    colony_check_ollama_local || colony_warn "Ollama/model not ready after restart."
  fi
  colony_log "restart complete (profile=${COLONY_PROFILE})."
}

cmd_status() {
  colony_load_env
  echo "=== Profile ==="
  echo "COLONY_PROFILE=${COLONY_PROFILE}"
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    echo "gpu_compose=$(colony_print_gpu_compose_invocation)"
  fi
  echo
  echo "=== Compose ==="
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    colony_compose_gpu_postgres ps || true
    colony_compose_gpu_dedicated ps || true
    colony_compose_gpu_api ps || true
  else
    colony_compose_local ps || true
  fi
  echo
  echo "=== Database ==="
  echo "database_url_target=${COLONY_DB_NAME} user=${COLONY_DB_USER} host=${COLONY_DB_HOST}:${COLONY_DB_PORT}"
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    if colony_compose_gpu_postgres exec -T postgres pg_isready -U "${COLONY_DB_USER}" -d "${COLONY_DB_NAME}" >/dev/null 2>&1 \
      || { cid="$(colony_find_gpu_postgres_container || true)"; [[ -n "${cid}" ]] && docker exec "${cid}" pg_isready -U "${COLONY_DB_USER}" -d "${COLONY_DB_NAME}" >/dev/null 2>&1; }; then
      echo "postgres=ready db=${COLONY_DB_NAME}"
    else
      echo "postgres=not_ready db=${COLONY_DB_NAME}"
    fi
  else
    if colony_compose_local exec -T postgres pg_isready -U "${COLONY_DB_USER}" -d "${COLONY_DB_NAME}" >/dev/null 2>&1; then
      echo "postgres=ready db=${COLONY_DB_NAME}"
    else
      echo "postgres=not_ready db=${COLONY_DB_NAME}"
    fi
  fi
  colony_migration_sync_report || true
  echo
  echo "=== API ==="
  if colony_api_health; then echo "api_health=ok base=${COLONY_API_BASE}"; else echo "api_health=down base=${COLONY_API_BASE}"; fi
  if colony_api_ready; then echo "api_ready=ok"; else echo "api_ready=down"; fi
  if [[ "${COLONY_PROFILE}" == "local" ]]; then
    if colony_api_pid_alive; then echo "api_pid=$(cat "${COLONY_API_PID_FILE}")"; else echo "api_pid=none"; fi
  else
    echo "api_project=${COLONY_GPU_API_PROJECT}"
    echo "api_service=colony-api-test"
    colony_verify_gpu_api_identity || true
    colony_report_api_port_conflicts || true
  fi
  echo
  echo "=== Ollama ==="
  colony_check_ollama || true
  echo
  echo "=== Seed ==="
  echo "seed_database=${COLONY_DB_NAME}"
  if colony_seed_present; then
    echo "seed_science=present"
  else
    echo "seed_science=missing (manual seed only; never auto-reseed)"
  fi
}

cmd_logs() {
  colony_load_env
  local follow=()
  local services=()
  local arg
  for arg in "$@"; do
    case "${arg}" in
      -f|--follow) follow=(--follow) ;;
      api)
        if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
          colony_compose_gpu_api logs --tail 120 --no-color "${follow[@]}" colony-api-test
        elif [[ -f "${COLONY_API_LOG_FILE}" ]]; then
          if [[ ${#follow[@]} -gt 0 ]]; then tail -f "${COLONY_API_LOG_FILE}"; else tail -n 120 "${COLONY_API_LOG_FILE}"; fi
        else
          colony_warn "No API log at ${COLONY_API_LOG_FILE}"
        fi
        return 0
        ;;
      *) services+=("${arg}") ;;
    esac
  done
  if [[ "${COLONY_PROFILE}" == "gpu" ]]; then
    if [[ ${#services[@]} -eq 0 ]]; then
      colony_compose_gpu_dedicated logs --tail 80 --no-color "${follow[@]}"
    else
      colony_compose_gpu_dedicated logs --tail 80 --no-color "${follow[@]}" "${services[@]}"
    fi
  else
    if [[ ${#services[@]} -eq 0 ]]; then
      colony_compose_local logs --tail 80 --no-color "${follow[@]}"
    else
      colony_compose_local logs --tail 80 --no-color "${follow[@]}" "${services[@]}"
    fi
  fi
}

cmd_test() {
  colony_reject_volume_wipe "$@"
  colony_load_env
  colony_ensure_state_dir

  if ! command -v jq >/dev/null 2>&1; then
    colony_die "${EXIT_CONFIG}" "jq is required for ./scripts/colony test."
  fi
  if [[ "${AUTH_MODE}" != "development" ]]; then
    colony_die "${EXIT_CONFIG}" "test requires AUTH_MODE=development for Bearer principal auth."
  fi
  if ! colony_api_ready; then
    colony_die "${EXIT_READY}" "API not ready at ${COLONY_API_BASE}. Run ./scripts/colony --profile ${COLONY_PROFILE} up first."
  fi
  if ! colony_check_ollama; then
    colony_die "${EXIT_INFERENCE}" "Ollama/model unavailable for profile=${COLONY_PROFILE}. Never downloads models."
  fi
  if ! colony_seed_present; then
    colony_die "${EXIT_CONFIG}" "Science department missing. Seed manually once."
  fi

  colony_log "Enabling conversation execution (does not enable CEO goals) profile=${COLONY_PROFILE}..."
  colony_http_json PATCH "/api/v1/autonomy/settings" "${COLONY_ADMIN_BEARER}" \
    '{"conversationExecutionEnabled":true,"enabled":false}' >/dev/null

  local key="c174-colony-${COLONY_PROFILE}-$(date +%s)"
  local instruction="Compare chemical and ion propellant mass for a spacecraft with dry mass 1000 kg, delta-v 3000 m/s, chemical Isp 350 s, ion Isp 3000 s. Include thrust/duration tradeoff, assumptions, and a final comparison."
  local open_body
  open_body="$(jq -nc \
    --arg recipient "${COLONY_MATH_DEPARTMENT_ID}" \
    --arg reasoning "${COLONY_REASONING_DEPARTMENT_ID}" \
    --arg instruction "${instruction}" \
    --arg key "${key}" \
    '{
      recipientDepartmentId: $recipient,
      participantDepartmentIds: [$reasoning],
      topic: "Spacecraft propellant comparison (C1.7.4)",
      kind: "question",
      instruction: $instruction,
      idempotencyKey: $key
    }')"

  colony_log "Opening spacecraft conversation as Science against ${COLONY_API_BASE}..."
  local opened
  opened="$(colony_http_json POST "/api/v1/department-conversations" "${COLONY_SCIENCE_BEARER}" "${open_body}")"
  local conversation_id
  conversation_id="$(printf '%s' "${opened}" | jq -r '.turn.conversationId // .conversation.id // empty')"
  if [[ -z "${conversation_id}" || "${conversation_id}" == "null" ]]; then
    printf '%s\n' "${opened}" >&2
    colony_die "${EXIT_TEST}" "Could not parse conversation id from open response."
  fi
  colony_log "conversation_id=${conversation_id}"

  colony_log "Running autonomous loop (admin)..."
  local run_result="{}"
  run_result="$(colony_http_json POST "/api/v1/department-conversations/${conversation_id}/run" "${COLONY_ADMIN_BEARER}" || true)"
  printf '%s\n' "${run_result}" | jq '.' 2>/dev/null || printf '%s\n' "${run_result}"

  local deadline=$((SECONDS + COLONY_TEST_POLL_SECONDS))
  local status="open"
  while (( SECONDS < deadline )); do
    local runtime
    runtime="$(colony_http_json GET "/api/v1/department-conversations/${conversation_id}/runtime" "${COLONY_ADMIN_BEARER}")"
    status="$(printf '%s' "${runtime}" | jq -r '.status // "unknown"')"
    local runner
    runner="$(printf '%s' "${runtime}" | jq -r '.runnerStatus // "unknown"')"
    colony_log "poll status=${status} runner=${runner}"
    if [[ "${status}" != "open" ]]; then
      break
    fi
    if [[ "${runner}" == "idle" || "${runner}" == "stopped" || "${runner}" == "scheduled" ]]; then
      colony_http_json POST "/api/v1/department-conversations/${conversation_id}/run" "${COLONY_ADMIN_BEARER}" >/dev/null || true
    fi
    sleep 3
  done

  local detail claims verifications
  detail="$(colony_http_json GET "/api/v1/department-conversations/${conversation_id}" "${COLONY_ADMIN_BEARER}")"
  claims="$(colony_http_json GET "/api/v1/department-conversations/${conversation_id}/claims" "${COLONY_ADMIN_BEARER}")"
  verifications="$(colony_http_json GET "/api/v1/department-conversations/${conversation_id}/claim-verifications" "${COLONY_ADMIN_BEARER}")"

  local out="${COLONY_STATE_DIR}/c174-${COLONY_PROFILE}-last.json"
  jq -n \
    --arg profile "${COLONY_PROFILE}" \
    --argjson detail "${detail}" \
    --argjson claims "${claims}" \
    --argjson verifications "${verifications}" \
    --argjson run "${run_result:-null}" \
    '{profile:$profile, detail:$detail, claims:$claims, verifications:$verifications, lastRun:$run}' >"${out}"

  echo
  echo "=== Transcript ==="
  printf '%s' "${detail}" | jq -r '.lines[]? // empty'
  echo
  echo "=== Claims ==="
  printf '%s' "${claims}" | jq -r '.claims[]? | "\(.verificationStatus)\t\(.claimText)"'
  echo
  echo "=== Verifications ==="
  printf '%s' "${verifications}" | jq -r '.verifications[]? | "\(.verdict)\tmethod=\(.method)\tclaimed=\(.claimedValue)\tcomputed=\(.computedValue)\t\(.diagnostic // "")"'
  echo
  echo "=== Deliverables / progress ==="
  printf '%s' "${detail}" | jq '.conversation.progressState.deliverables // []'
  printf '%s' "${detail}" | jq '{
    status: .conversation.status,
    outcome: .conversation.outcome,
    closeReason: .conversation.closeReason,
    finalConclusion: .conversation.finalConclusion,
    deliverableParseStatus: .conversation.progressState.deliverableParseStatus,
    pendingCorrections: .conversation.progressState.pendingCorrections,
    refutedClaimNotices: .conversation.progressState.refutedClaimNotices,
    substantialProgress: .conversation.progressState.substantialProgress,
    terminationReason: .conversation.progressState.terminationReason,
    evidenceRefs: .conversation.evidenceRefs,
    failedGenerations: .conversation.progressState.failedGenerations,
    lastError: .conversation.lastError
  }'
  echo
  echo "Artifact: ${out}"

  local final_status
  final_status="$(printf '%s' "${detail}" | jq -r '.conversation.status')"
  if [[ "${final_status}" == "open" ]]; then
    colony_warn "Conversation still open after poll window (${COLONY_TEST_POLL_SECONDS}s)."
    exit "${EXIT_TEST}"
  fi
  colony_log "test complete profile=${COLONY_PROFILE} status=${final_status}"
}

main() {
  colony_parse_global_args "$@"
  set -- "${COLONY_ARGS[@]}"
  local cmd="${1:-help}"
  shift || true
  colony_reject_volume_wipe "$@"
  case "${cmd}" in
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    deploy) cmd_deploy "$@" ;;
    restart) cmd_restart "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    test) cmd_test "$@" ;;
    help|-h|--help) usage ;;
    *)
      usage >&2
      colony_die "${EXIT_USAGE}" "Unknown command: ${cmd}"
      ;;
  esac
}

main "$@"
