#!/usr/bin/env bash
# C1.8D.1 Stage C — locked ID / OOD baselines + in-repo regression AFTER freeze.
# Locked JSONL must come from C18D1_LOCKED_DATA_DIR (outside the repo).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

if [[ "${C18D1_BENCHMARK_FROZEN:-}" != "1" ]]; then
  echo "[c18d1] Refusing Stage C: set C18D1_BENCHMARK_FROZEN=1 after Stage B freeze."
  exit 1
fi
if [[ -z "${C18D1_LOCKED_DATA_DIR:-}" ]]; then
  echo "[c18d1] Set C18D1_LOCKED_DATA_DIR (outside repo), e.g. /var/lib/ai-colony/evaluation/c18d1-locked-v2"
  exit 1
fi

PYTHON="${C18D1_PYTHON:-python3}"
OUT_ROOT="${C18D1_OUT:-${C18D1_LOCKED_DATA_DIR}/results/baselines-$(date +%Y%m%d-%H%M%S)}"
VENV="${C18D1_VENV:-${ROOT}/tmp/c18d1/.venv-gpu}"
BATCH="${C18D1_BATCH_SIZE:-4}"
CONDITION="${C18D1_CONDITION:-thinking_enabled_zero_shot}"
LOCKED_DATA="$(cd "${C18D1_LOCKED_DATA_DIR}" && pwd)"

case "${LOCKED_DATA}" in
  "${ROOT}"|"${ROOT}"/*)
    echo "[c18d1] C18D1_LOCKED_DATA_DIR must be outside the repo (${ROOT})"
    exit 1
    ;;
esac

if [[ "${C18D1_SKIP_INSTALL:-}" != "1" ]]; then
  "${PYTHON}" -m venv "${VENV}"
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  pip install -U pip
  pip install -r services/training/cuda/requirements-c18d1.txt
  PYTHON="${VENV}/bin/python"
fi

"${PYTHON}" services/training/cuda/c18d1/revisions.py --write
PIN_MODEL=$("${PYTHON}" -c "import json;print(json.load(open('services/training/cuda/c18d1/pinned_revisions.json'))['modelRevision'])")

run_one() {
  local NAME="$1"
  local DATA="$2"
  local OUT="${OUT_ROOT}/${NAME}"
  mkdir -p "${OUT}"
  cat > "${OUT}/job.json" <<EOF
{
  "modelId": "Qwen/Qwen3-8B",
  "tokenizerId": "Qwen/Qwen3-8B",
  "modelRevision": "${PIN_MODEL}",
  "tokenizerRevision": "${PIN_MODEL}",
  "conditionId": "${CONDITION}",
  "datasetPath": "${DATA}",
  "outputDir": "${OUT}",
  "device": "cuda",
  "batchSize": ${BATCH},
  "seed": 18,
  "accessRole": "evaluation",
  "departmentId": "00000000-0000-4000-8000-000000000017"
}
EOF
  echo "[c18d1] Stage C ${NAME}"
  "${PYTHON}" services/training/cuda/c18d1/batched_eval.py --job "${OUT}/job.json"
}

run_one locked_id "${LOCKED_DATA}/id_locked.jsonl"
run_one locked_ood "${LOCKED_DATA}/ood_locked.jsonl"
run_one regression "${ROOT}/services/training/cuda/c18d1/datasets/regression/regression.jsonl"

echo "[c18d1] Stage C complete under ${OUT_ROOT}"
echo "[c18d1] Publish aggregates only; keep item-level artifacts under ${LOCKED_DATA}/results"
