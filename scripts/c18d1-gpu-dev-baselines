#!/usr/bin/env bash
# C1.8D.1 Stage B — full development baselines (no locked tests).
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

PYTHON="${C18D1_PYTHON:-python3}"
OUT_ROOT="${C18D1_OUT:-${ROOT}/tmp/c18d1/dev-baselines-$(date +%Y%m%d-%H%M%S)}"
VENV="${C18D1_VENV:-${ROOT}/tmp/c18d1/.venv-gpu}"
BATCH="${C18D1_BATCH_SIZE:-4}"

if [[ "${C18D1_SKIP_INSTALL:-}" != "1" ]]; then
  "${PYTHON}" -m venv "${VENV}"
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  pip install -U pip
  pip install -r services/training/cuda/requirements-c18d1.txt
  PYTHON="${VENV}/bin/python"
fi

"${PYTHON}" services/training/cuda/c18d1/revisions.py --write
PIN_MODEL=$("${PYTHON}" -c "import json;print(json.load(open('services/training/cuda/c18d1/pinned_revisions.json'))['modelRevision'])")
DATA="$(pwd)/services/training/cuda/c18d1/datasets/dev/id_dev.jsonl"

for CONDITION in thinking_disabled_zero_shot thinking_enabled_zero_shot; do
  OUT="${OUT_ROOT}/${CONDITION}"
  mkdir -p "${OUT}"
  JOB="${OUT}/job.json"
  cat > "${JOB}" <<EOF
{
  "modelId": "Qwen/Qwen3-8B",
  "tokenizerId": "Qwen/Qwen3-8B",
  "modelRevision": "${PIN_MODEL}",
  "tokenizerRevision": "${PIN_MODEL}",
  "conditionId": "${CONDITION}",
  "datasetPath": "${DATA}",
  "outputDir": "${OUT}",
  "device": "cuda",
  "batchSize": ${BATCH},
  "seed": 18,
  "accessRole": "evaluation",
  "departmentId": "00000000-0000-4000-8000-000000000017"
}
EOF
  echo "[c18d1] Stage B running ${CONDITION}"
  "${PYTHON}" services/training/cuda/c18d1/batched_eval.py --job "${JOB}"
done

echo "[c18d1] Stage B complete under ${OUT_ROOT}"
echo "[c18d1] Freeze strongest practical baseline using DEVELOPMENT results only before Stage C."
