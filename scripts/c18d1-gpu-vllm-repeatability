#!/usr/bin/env bash
# C1.8D.1 — vLLM same-config repeatability (greedy + fixed-seed sampled).
# Continuous batching varies composition; vLLM is not official unless this passes.
# Does not overwrite HF Gate v3 evidence. Development only. No Stage B/C.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

PYTHON="${C18D1_PYTHON:-python3}"
OUT="${C18D1_OUT:-${ROOT}/tmp/c18d1/vllm-repeatability-$(date +%Y%m%d-%H%M%S)}"
VENV="${C18D1_VENV:-${ROOT}/tmp/c18d1/.venv-gpu}"
LIMIT="${C18D1_PILOT_LIMIT:-24}"
SEED="${C18D1_SEED:-18}"
MAX_NEW="${C18D1_MAX_NEW_TOKENS:-512}"

echo "[c18d1] vLLM repeatability limit=${LIMIT} out=${OUT}"
command -v nvidia-smi >/dev/null && nvidia-smi || echo "[c18d1] WARN: nvidia-smi missing"

if [[ "${C18D1_SKIP_INSTALL:-}" != "1" ]]; then
  "${PYTHON}" -m venv "${VENV}"
  # shellcheck disable=SC1091
  source "${VENV}/bin/activate"
  pip install -U pip
  pip install -r services/training/cuda/requirements-c18d1.txt
  pip install "vllm>=0.6.0"
  PYTHON="${VENV}/bin/python"
fi

"${PYTHON}" services/training/cuda/c18d1/revisions.py --write
mkdir -p "${OUT}"
JOB="${OUT}/vllm-repeat-job.json"
python3 - <<PY
import json
from pathlib import Path
pin = json.loads(Path("services/training/cuda/c18d1/pinned_revisions.json").read_text())
job = {
  "modelId": pin["modelId"],
  "tokenizerId": pin["tokenizerId"],
  "modelRevision": pin["modelRevision"],
  "tokenizerRevision": pin["tokenizerRevision"],
  "conditionId": "thinking_disabled_zero_shot",
  "datasetPath": str(Path("services/training/cuda/c18d1/datasets/dev/id_dev.jsonl").resolve()),
  "outputDir": "${OUT}",
  "device": "cuda",
  "limit": int("${LIMIT}"),
  "seed": int("${SEED}"),
  "maxNewTokens": int("${MAX_NEW}"),
  "accessRole": "evaluation",
  "departmentId": "00000000-0000-4000-8000-000000000017",
}
Path("${JOB}").write_text(json.dumps(job, indent=2) + "\n")
print(json.dumps(job, indent=2))
PY

set +e
"${PYTHON}" services/training/cuda/c18d1/vllm_repeatability.py --job "${JOB}"
RC=$?
set -e
echo "[c18d1] vLLM repeatability report: ${OUT}/vllm-repeatability-report.json (exit=${RC})"
echo "[c18d1] Report result either way; vLLM official eligibility requires passed=true."
echo "[c18d1] STOP — review before further work."
exit "${RC}"
