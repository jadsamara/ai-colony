# Local development only. Copy to .env and adjust if needed.
# Do not point production at these credentials.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Docker Compose publishes PostgreSQL on 5433 unless POSTGRES_PORT is set.
# Use another port when a local PostgreSQL already owns 127.0.0.1:5433.
# Docker's 0.0.0.0 mapping does not override a process bound to 127.0.0.1.
POSTGRES_PORT=5433
DATABASE_URL=postgres://colony:colony@127.0.0.1:5433/ai_colony

# development: trust a Bearer principal UUID. Refused when NODE_ENV=production.
# disabled: every route except health, readiness, and docs returns 401.
AUTH_MODE=development

# Heartbeat older than this many milliseconds is treated as a dead runtime.
RUNTIME_STALE_AFTER_MS=30000

# Local RabbitMQ. The management UI is http://127.0.0.1:15672
# and is bound to localhost only. Do not publish it on a public interface.
RABBITMQ_URL=amqp://colony:colony-dev-password@127.0.0.1:5672
RABBITMQ_USER=colony
RABBITMQ_PASSWORD=colony-dev-password
MESSAGING_PREFETCH=10
MESSAGING_MAX_HANDLER_ATTEMPTS=5
MESSAGING_MAX_PUBLISH_ATTEMPTS=8
MESSAGING_RETRY_BASE_MS=1000
MESSAGING_RETRY_MAX_DELAY_MS=60000
MESSAGING_LEASE_MS=30000
MESSAGING_POLL_MS=500

# Local Ollama. The alias must be the id returned by GET /v1/models.
# Requests are not sent to OpenAI. A shared profile runs every role through the
# one loaded model and records that alias. It does not mark Qwen3-4B ready.
INFERENCE_BASE_URL=http://127.0.0.1:11434
# Live model health uses GET /api/version, /api/tags, and /api/ps only.
# Results stay in process memory. A persisted runtime row is not current availability.
# Timeout is per request. A repeated probe of the same target waits for the minimum interval.
# Evidence older than the freshness window is stale and cannot keep inference readiness verified.
OLLAMA_PROBE_TIMEOUT_MS=3000
OLLAMA_PROBE_FRESHNESS_MS=60000
OLLAMA_PROBE_MIN_INTERVAL_MS=10000
INFERENCE_MODEL_ALIAS=qwen3:8b
INFERENCE_MEMORY_PROFILE=shared
INFERENCE_CONTEXT_WINDOW=8192
INFERENCE_MAX_OUTPUT_TOKENS=1024
INFERENCE_TEMPERATURE=0.2
INFERENCE_TIMEOUT_MS=120000
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_TRANSPORT_RETRIES=2
OBJECTIVE_GLOBAL_CONCURRENCY=1
OBJECTIVE_DEPARTMENT_CONCURRENCY=1
# Optional. Leave unset to report cost as unavailable. Do not hardcode a GPU price.
# INFERENCE_INPUT_USD_PER_MILLION=
# INFERENCE_OUTPUT_USD_PER_MILLION=
MONITORING_ALLOW_RECOVERY=false

# Ollama embeddings. embeddinggemma returned 768 values from POST /api/embed.
# Do not point this at the Qwen3 chat model. A different dimension needs a new column.
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_CONCURRENCY=1
EMBEDDING_TRANSPORT_RETRIES=2
MEMORY_TOP_K=5
MEMORY_CONTEXT_TOKENS=800
MEMORY_MAX_WRITES_PER_OBJECTIVE=12

# Training stays off the production Ollama route. mlx runs only after an
# administrator records training:approve. The default provider is the test double.
TRAINING_PROVIDER=scripted
# TRAINING_PYTHON=services/training/.venv/bin/python
